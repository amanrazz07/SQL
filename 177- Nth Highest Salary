CREATE FUNCTION getNthHighestSalary(N INT) RETURNS INT
BEGIN
    RETURN (
        WITH SalaryRank AS (
            SELECT salary,
                   DENSE_RANK() OVER(ORDER BY salary DESC) AS rnk
            FROM Employee
        )
        SELECT salary
        FROM SalaryRank
        WHERE rnk = N
        LIMIT 1
    );
END
